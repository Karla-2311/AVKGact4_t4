meta {
  name: 01 - Registro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nombre": "Estudiante Prueba",
    "email": "estudiante@correo.com",
    "password": "Password123"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("token", res.body.token);
  }
}

assert {
  res.status: eq 201
}
